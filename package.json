{
  "name": "@max-null/dsh-memory",
  "version": "0.3.4",
  "description": "Cross-session plaintext memory plugin for the DeepSeek Harness — deterministic BM25 recall, human-owned, no embeddings",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "plugin",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Max-Null/dsh-memory.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-storage": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-json": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-storage": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-json": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.5",
    "@types/node": "^26.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
